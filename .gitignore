# =========================================================
#  .gitignore — ClubMailer (C# / .NET 10)
#  Éditeurs : Visual Studio, VS Code, Rider
#
#  RÈGLE RGPD : tout nouveau fichier qui contient des données
#  de participants doit être couvert ici AVANT le premier commit.
#  Vérifier avec :  git check-ignore -v --no-index <fichier>
# =========================================================

# ---------- Sorties de compilation ----------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]64/
out/
publish/
artifacts/

# ---------- Visual Studio ----------
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs

# ---------- VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------- JetBrains Rider ----------
.idea/
*.sln.iml

# ---------- Claude Code ----------
# settings.json (partagé, bloque la lecture de exemple.cs) reste suivi ;
# settings.local.json contient les réglages personnels de la machine.
.claude/settings.local.json

# ---------- NuGet ----------
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# ---------- Tests & couverture ----------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# ---------- Fichiers temporaires / cache ----------
*.tmp
*.cache
*.bak
*.orig
*.pdb
*.ilk
*.obj
*.pch
*_i.c
*_p.c
*.tlb
*.tli
*.tlh
ScaffoldingReadMe.txt
# Dossier de fichiers mis de côté avant suppression (peut contenir des données)
_to_delete/

# ---------- Secrets & config locale ----------
# Ne JAMAIS committer de mots de passe (SMTP, API Anthropic, BDD...).
# Les vrais secrets vont dans les user-secrets (hors du dépôt).
appsettings.Development.json
appsettings.Local.json
*.local.json
.env
.env.*
!.env.example
secrets.json
*.pfx
*.key

# ---------- Données personnelles (RGPD) ----------
# Exports d'inscriptions et fichiers de données
*.csv
*.tsv
*.xlsx
*.xls
*.ods
# Fichiers produits par l'application
liste_diffusion.json
rapport_*.json
# Journaux (peuvent contenir des noms et des emails)
*.log
[Ll]og/
[Ll]ogs/
# Exception : fichiers de test anonymisés (données inventées uniquement).
# Chemin à aligner au Module 9 ter (prévu : tests/ClubMailer.Tests/Fixtures/).
!tests/data/*.csv

# ---------- Bases de données locales (SQLite, Module 11) ----------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf

# ---------- Système d'exploitation ----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
._*
# Linux
*~
