# =========================================================
#  .gitignore pour projets C# / .NET
#  (Visual Studio, VS Code, Rider)
# =========================================================

# ---------- Sorties de compilation ----------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]64/
[Ll]og/
[Ll]ogs/
out/
publish/
artifacts/

# ---------- Visual Studio ----------
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs

# ---------- VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------- JetBrains Rider ----------
.idea/
*.sln.iml

# ---------- NuGet ----------
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# ---------- Tests & couverture ----------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResults/

# ---------- Fichiers temporaires / cache ----------
*.tmp
*.cache
*.log
*.pdb
*.ilk
*.obj
*.pch
*_i.c
*_p.c
*.tlb
*.tli
*.tlh
ScaffoldingReadMe.txt

# ---------- Secrets & config locale ----------
# Ne JAMAIS committer de mots de passe (SMTP, API, BDD...)
appsettings.Development.json
appsettings.Local.json
*.local.json
.env
.env.*
!.env.example
secrets.json

# ---------- Fichiers Sensibles et CSV ----------
*.csv
liste_diffusion.json

# ---------- Bases de données locales ----------
*.db
*.db-shm
*.db-wal
*.sqlite
*.mdf
*.ldf

# ---------- Système d'exploitation ----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
._*
# Linux
*~
